# =============================================================================
# Dockerfile.lambda — SkillBridge Lambda container image
# =============================================================================
#
# Strategy
# --------
# Stage 1  (nestjs-build): Alpine — compile TypeScript to dist/.  Only the
#           compiled JS is used from this stage; node_modules are NOT carried
#           forward (native addons compiled for musl crash on glibc).
#
# Stage 2  (deps-glibc): Debian slim (glibc) — install production-only
#           node_modules so native addons (bcrypt, onnxruntime-node) are
#           compiled against the same libc family as the Lambda runtime.
#
# Stage 3  (model-download): Debian slim (glibc) — pre-download the ONNX
#           embedding model so Lambda cold starts never need internet access.
#
# Stage 4  (lambda-runtime): Python 3.12 Lambda base image (AL2023 / glibc)
#           with Node.js 20, glibc-built node_modules, baked-in ONNX model,
#           and Python automation handlers.
#
# Build context: project root
#   docker build --platform linux/amd64 --provenance=false \
#     -f Dockerfile.lambda -t <ecr-uri>:latest .
# =============================================================================

# ── Stage 1: compile NestJS (Alpine — TypeScript only) ───────────────────────
# Native addons from this stage are NOT used in later stages.

FROM node:20-alpine AS nestjs-build

WORKDIR /build

# Install ALL dependencies (dev + prod) for tsc compilation
COPY nestjs-backend/package.json nestjs-backend/package-lock.json ./
RUN npm ci --legacy-peer-deps

# Copy source and compile
COPY nestjs-backend/ .
RUN npm run build


# ── Stage 2: production node_modules on glibc ────────────────────────────────
# Native addons (bcrypt, onnxruntime-node) MUST be compiled on the same libc
# as the runtime.  node:20-slim uses Debian/glibc — compatible with AL2023.

FROM node:20-slim AS deps-glibc

WORKDIR /app

COPY nestjs-backend/package.json nestjs-backend/package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps


# ── Stage 3: pre-download ONNX embedding model ──────────────────────────────
# Bakes Xenova/bge-small-en-v1.5 into the image so EmbeddingService works
# without internet access (no NAT Gateway required at Lambda runtime).

FROM node:20-slim AS model-download

WORKDIR /app

COPY --from=deps-glibc /app/node_modules ./node_modules
COPY nestjs-backend/scripts/download-model.cjs ./scripts/download-model.cjs
RUN node scripts/download-model.cjs


# ── Stage 4: Lambda runtime ──────────────────────────────────────────────────

FROM public.ecr.aws/lambda/python:3.12

# Install Node.js 20 from NodeSource (AL2023 default repos only have Node 18).
# No build tools needed — native addons are pre-compiled in the deps-glibc stage.
RUN curl -fsSL https://rpm.nodesource.com/setup_20.x | bash - \
    && dnf install -y nodejs \
    && dnf clean all \
    && node --version \
    && npm --version

# boto3 is pre-installed in all Lambda Python runtimes.
# Install 'requests' for the warmup Lambda and any ad-hoc HTTP calls.
RUN pip install --no-cache-dir requests

# ── Python automation handlers ────────────────────────────────────────────────
# lambdas/automation/*.py — triggered via CMD override by EventBridge.
# lambdas/*.py            — specialist handlers (voice, rag, embeddings…).
COPY lambdas/ ${LAMBDA_TASK_ROOT}/lambdas/

# ── NestJS compiled app ───────────────────────────────────────────────────────
# dist/ from nestjs-build (JS only), node_modules from deps-glibc (glibc native addons).
COPY --from=nestjs-build /build/dist         ${LAMBDA_TASK_ROOT}/nestjs/dist/
COPY --from=deps-glibc   /app/node_modules   ${LAMBDA_TASK_ROOT}/nestjs/node_modules/
COPY --from=nestjs-build /build/package.json ${LAMBDA_TASK_ROOT}/nestjs/package.json

# ── Baked-in ONNX embedding model ─────────────────────────────────────────────
COPY --from=model-download /app/.cache/huggingface ${LAMBDA_TASK_ROOT}/nestjs/.cache/huggingface

# ── Seed data (JSON files read by DatabaseSeeder on cold start) ───────────────
COPY data/ ${LAMBDA_TASK_ROOT}/data/

# ── Main Lambda entry point ───────────────────────────────────────────────────
# lambda_handler.py starts the NestJS process on cold start and proxies
# API Gateway events (both v1 and v2 payload formats) to localhost.
COPY lambda_handler.py ${LAMBDA_TASK_ROOT}/

CMD ["lambda_handler.handler"]
