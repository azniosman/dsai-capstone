# ============================================================================
# SkillBridge Lambda Container Image
#
# Build context: project root (same as backend/Dockerfile)
# Uses the AWS Lambda Python 3.11 base image which includes the Lambda
# Runtime Interface Client (RIC) — no uvicorn needed.
#
# CMD = "lambda_handler.handler" (module.function)
# Terraform image_config.command can override this if needed.
#
# Build command (from project root):
#   docker build -f backend/Dockerfile.lambda -t skillbridge-lambda .
# ============================================================================

FROM public.ecr.aws/lambda/python:3.11

# ── Python dependencies ──────────────────────────────────────────────────────
# All packages use pre-compiled wheels (psycopg2-binary, bcrypt wheel, etc.)
# so no native build tools (gcc/python3-devel) are required.

COPY backend/requirements.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN yum install -y gcc gcc-c++ python3-devel && \
    pip install --upgrade pip && \
    pip install --no-cache-dir --prefer-binary -r ${LAMBDA_TASK_ROOT}/requirements.txt && \
    yum remove -y gcc gcc-c++ python3-devel && \
    yum clean all

# ── Pre-download NLP models (Lambda runs in private subnet — no internet) ────

ENV SENTENCE_TRANSFORMERS_HOME=/opt/models/sentence-transformers
ENV HF_HOME=/opt/models/huggingface



RUN python -c "\
    from sentence_transformers import SentenceTransformer; \
    SentenceTransformer('all-MiniLM-L6-v2'); \
    print('Sentence Transformer model cached OK')"

# Verify offline mode works (will be used in Lambda VPC)
RUN HF_HUB_OFFLINE=1 python -c "\
    import os; os.environ['HF_HUB_OFFLINE']='1'; \
    from sentence_transformers import SentenceTransformer; \
    m = SentenceTransformer('all-MiniLM-L6-v2'); print('Offline mode OK')"

# Lock models offline for production
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

# ── Application code ─────────────────────────────────────────────────────────

COPY backend/app/ ${LAMBDA_TASK_ROOT}/app/
COPY backend/lambda_handler.py ${LAMBDA_TASK_ROOT}/
COPY data/seed/ ${LAMBDA_TASK_ROOT}/seed_data/

# ── Lambda handler entrypoint ─────────────────────────────────────────────────

CMD ["lambda_handler.handler"]
