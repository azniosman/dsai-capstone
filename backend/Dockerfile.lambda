# ============================================================================
# SkillBridge Lambda Container Image
# ============================================================================

FROM public.ecr.aws/lambda/python:3.11

# ===== Set environment variables =====
ENV PYTHONUNBUFFERED=1
ENV SENTENCE_TRANSFORMERS_HOME=/opt/models/sentence-transformers
ENV HF_HOME=/opt/models/huggingface
ENV HF_HUB_OFFLINE=1

# Create directories for models
RUN mkdir -p /opt/models/sentence-transformers /opt/models/huggingface

# ===== Install system dependencies =====
RUN yum install -y gcc gcc-c++ python3-devel git curl && \
    yum clean all

# ===== Install Python dependencies =====
RUN pip install --upgrade pip

# Copy project requirements
COPY backend/requirements.txt ${LAMBDA_TASK_ROOT}/requirements.txt

# Install dependencies from requirements.txt
# Pin numpy and scikit-learn for compatibility
RUN pip install --no-cache-dir "numpy<2.0.0" "scikit-learn==1.3.2" && \
    pip install --no-cache-dir --prefer-binary -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Install specific spaCy version (User request)
RUN pip install --no-cache-dir spacy==3.7.0

# Install spaCy English model (matching version)
RUN pip install --no-cache-dir \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.7.0/en_core_web_sm-3.7.0-py3-none-any.whl

# Verify spaCy model works
RUN python -c "import spacy; nlp = spacy.load('en_core_web_sm'); print('spaCy OK')"

# Install Sentence Transformers (User request)
RUN pip install --no-cache-dir sentence-transformers==2.2.2

# Pre-download Sentence Transformer model so it's cached in the image
RUN HF_HUB_OFFLINE=0 python -c "import os; os.environ['SENTENCE_TRANSFORMERS_HOME']='/opt/models/sentence-transformers'; from sentence_transformers import SentenceTransformer; m = SentenceTransformer('all-MiniLM-L6-v2'); print('ST OK')"

# Lock models offline for production
ENV TRANSFORMERS_OFFLINE=1

# ===== Copy project files =====
COPY backend/app/ ${LAMBDA_TASK_ROOT}/app/
COPY backend/lambda_handler.py ${LAMBDA_TASK_ROOT}/
COPY data/seed/ ${LAMBDA_TASK_ROOT}/seed_data/

# Verify offline mode works (will be used in Lambda VPC)
RUN python -c "import os; os.environ['SENTENCE_TRANSFORMERS_HOME']='/opt/models/sentence-transformers'; os.environ['HF_HUB_OFFLINE']='1'; from sentence_transformers import SentenceTransformer; m = SentenceTransformer('all-MiniLM-L6-v2'); print('Offline mode Verify OK')"

# ===== Lambda handler entrypoint =====
CMD ["lambda_handler.handler"]
