# ============================================================================
# SkillBridge Lambda Container Image
# ============================================================================

FROM public.ecr.aws/lambda/python:3.11

# ===== Set environment variables =====
ENV PYTHONUNBUFFERED=1
ENV SENTENCE_TRANSFORMERS_HOME=/opt/models/sentence-transformers
ENV HF_HOME=/opt/models/huggingface
ENV HF_HUB_OFFLINE=1

# Create directories for models
RUN mkdir -p /opt/models/sentence-transformers /opt/models/huggingface

# ===== Install system dependencies =====
# cmake: needed for sentencepiece source build fallback
# git/curl: needed for some pip installs or healthchecks
RUN yum install -y git curl cmake && \
    yum clean all

# ===== Install Python dependencies =====
RUN pip install --upgrade pip

# 1. Scientific Stack: Force binary wheels to avoid GCC compilation issues
#    (numpy, scipy, scikit-learn often fail to build on Amazon Linux 2 without this)
RUN pip install --no-cache-dir --prefer-binary \
    "numpy<2.0.0" \
    "scikit-learn==1.3.2" \
    "scipy"

# 2. NLP Stack: Install spacy and model explicitly via direct URL
#    (Fixes 404 errors from 'python -m spacy download')
RUN pip install --no-cache-dir "spacy==3.7.0" && \
    pip install --no-cache-dir https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.7.0/en_core_web_sm-3.7.0-py3-none-any.whl && \
    python -c "import spacy; nlp = spacy.load('en_core_web_sm'); print('spaCy OK')"

# 3. AI Stack — CPU-only PyTorch + Sentence Transformers
# Install torch CPU first so pip doesn't pull the 2GB+ CUDA variant later.
# Lambda has no GPU; torch+cpu is ~200MB vs ~2GB for the default CUDA build.
RUN pip install --no-cache-dir \
    "torch==2.0.1+cpu" \
    --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir --prefer-binary \
    "sentencepiece" \
    "sentence-transformers==2.2.2" \
    "huggingface-hub<0.25.0"

# 4. Project Requirements: Install remaining dependencies
COPY backend/requirements.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --no-cache-dir --prefer-binary -r ${LAMBDA_TASK_ROOT}/requirements.txt

# ===== Pre-download Models =====

# Download Sentence Transformer model (Temporarily enable online mode)
RUN HF_HUB_OFFLINE=0 python -c "import os; os.environ['SENTENCE_TRANSFORMERS_HOME']='/opt/models/sentence-transformers'; from sentence_transformers import SentenceTransformer; m = SentenceTransformer('all-MiniLM-L6-v2'); print('ST OK')"

# Verify offline mode works
RUN python -c "import os; os.environ['SENTENCE_TRANSFORMERS_HOME']='/opt/models/sentence-transformers'; os.environ['HF_HUB_OFFLINE']='1'; from sentence_transformers import SentenceTransformer; m = SentenceTransformer('all-MiniLM-L6-v2'); print('Offline mode Verify OK')"

# Lock models offline for production safely
ENV TRANSFORMERS_OFFLINE=1

# ===== Application Setup =====
COPY backend/app/ ${LAMBDA_TASK_ROOT}/app/
COPY backend/lambda_handler.py ${LAMBDA_TASK_ROOT}/
COPY data/seed/ ${LAMBDA_TASK_ROOT}/seed_data/

CMD ["lambda_handler.handler"]
