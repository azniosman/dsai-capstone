# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to git (it contains secrets).

aws_region   = "us-east-1"
project_name = "skillbridge"
environment  = "dev"

# Database
db_username = "skillbridge"
db_password = "CHANGE_ME_use_openssl_rand_base64_24"

# Backend JWT signing key
secret_key = "CHANGE_ME_use_openssl_rand_hex_32"

# LLM provider keys — provider chain: groq → claude → gemini
# At least one key must be set for AI features to work.
groq_api_key      = ""   # Primary: Groq (fast, free tier available)
anthropic_api_key = ""   # Secondary: Claude via Anthropic API
gemini_api_key    = ""   # Tertiary: Google Gemini

# Set after first ECR apply + docker push:
# lambda_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/skillbridge-dev-backend:latest"

# OpenSearch adds ~$26/month — keep false for basic demo
enable_opensearch = false

# Lambda sizing (1024 MB recommended for sentence-transformers cold start)
lambda_memory_mb       = 1024
lambda_timeout_seconds = 29

# ─── EventBridge Automation Layer ───────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
internal_automation_token = "CHANGE_ME_use_python_secrets_token_hex_32"

# Email for CloudWatch alarm notifications
ops_email = "your@email.com"

# Disable warm-up pings when stack is idle (saves Lambda invocations)
enable_warmup = true
