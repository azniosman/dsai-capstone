# Production Environment Configuration
# ====================================
# Copy this file to .env.production and update values
# NEVER commit this file with actual secrets

# ── Database Configuration ────────────────────────────────────────────────────
DATABASE_URL=postgresql://capstone:CHANGE_ME_IN_PROD@db:5432/capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=CHANGE_ME_IN_PROD
POSTGRES_DB=capstone
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Backend Configuration ─────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NODE_ENV=production

# ── Frontend Configuration ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.skillbridge.internal
NEXT_OUTPUT=export

# ── JWT Authentication (GENERATE NEW VALUES FOR PRODUCTION) ───────────────────
# Generate with: node scripts/generate-jwt-secrets.js
JWT_SECRET=GENERATE_WITH_SCRIPT_64_CHARS_MINIMUM
REFRESH_TOKEN_SECRET=GENERATE_WITH_SCRIPT_64_CHARS_MINIMUM

# Token expiration settings
ACCESS_TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# ── Internal Automation (GENERATE NEW VALUE FOR PRODUCTION) ──────────────────
# Generate with: node scripts/generate-jwt-secrets.js
INTERNAL_AUTOMATION_TOKEN=GENERATE_WITH_SCRIPT_64_CHARS_MINIMUM

# ── CORS Configuration ────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=["https://skillbridge.internal","https://admin.skillbridge.internal"]

# ── LLM Configuration (Optional) ──────────────────────────────────────────────
# Priority order: groq → claude → gemini
PRIMARY_LLM=groq
SECONDARY_LLM=claude
TERTIARY_LLM=gemini

# Groq (primary)
GROQ_API_KEY=sk-CHANGE_ME_IN_PROD
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (secondary)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME_IN_PROD
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (tertiary)
GEMINI_API_KEY=CHANGE_ME_IN_PROD
GEMINI_MODEL=gemini-2.0-flash

# AI parameters
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048

# ── Embedding Model Configuration ─────────────────────────────────────────────
# Model is baked into Docker image at build time
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Optional: Cross-encoder re-ranking (disabled by default)
RERANKER_ENABLED=false
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=20

# ── SSG/WSG API Integration (Optional) ────────────────────────────────────────
# Leave empty to use seeded data fallback
SSG_CLIENT_ID=
SSG_CLIENT_SECRET=
SSG_API_BASE_URL=https://api.ssg-wsg.sg
SSG_TOKEN_URL=
SSG_CACHE_TTL_SECONDS=3600

# ── AWS Configuration (for Lambda deployment) ─────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=CHANGE_ME_IN_PROD
AWS_SECRET_ACCESS_KEY=CHANGE_ME_IN_PROD

# ── Production Assurance Configuration ────────────────────────────────────────
# JWT token for production assurance API access
# Generate with: node scripts/generate-jwt-secrets.js --token --email admin@skillbridge.com
PROD_JWT_TOKEN=GENERATE_WITH_SCRIPT

# Alert thresholds
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_LATENCY_P95_THRESHOLD=500
ALERT_READINESS_SCORE_THRESHOLD=60

# ── Logging Configuration ─────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=60

# ── Security Configuration ────────────────────────────────────────────────────
# Account lockout after failed attempts
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Password requirements
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# ── Session Configuration ─────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=1440
CONCURRENT_SESSIONS_LIMIT=5

# ── Backup Configuration ──────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=skillbridge-backups-prod

# ── Monitoring Configuration ──────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# ── Production Assurance ──────────────────────────────────────────────────────
# Automated audit schedule
AUDIT_SCHEDULE=0 */6 * * *
RAG_VERIFY_SCHEDULE=0 * * * *
RECOVERY_CHECK_SCHEDULE=*/5 * * * *

# ── Live Matrix Dataset ───────────────────────────────────────────────────────
LIVE_MATRIX_SOURCE_URL=/app/data/seed/skills_intelligence.csv
