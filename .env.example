# PostgreSQL
POSTGRES_USER=capstone
POSTGRES_PASSWORD=changeme
POSTGRES_DB=capstone
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://capstone:changeme@db:5432/capstone

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000

# Auth
SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM Router ────────────────────────────────────────────────────────────────
# Priority order for LLM providers. Supported values: bedrock | claude | gemini
# The router attempts providers in this order, falling back automatically on failure.
PRIMARY_LLM=bedrock
SECONDARY_LLM=claude
TERTIARY_LLM=gemini

# AWS Bedrock (primary) — uses ambient IAM credentials / instance role in prod
# Recommended model: Haiku (lowest cost), upgrade to Sonnet for higher quality
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0  # higher quality, higher cost

# Anthropic Claude direct API (secondary fallback)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (tertiary fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AWS (Serverless & AI — additional services)
SAGEMAKER_EMBEDDING_ENDPOINT=
OPENSEARCH_HOST=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ML
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Internal automation shared secret (EventBridge Lambda-to-Lambda)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_AUTOMATION_TOKEN=change-me-in-production
