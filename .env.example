# PostgreSQL
POSTGRES_USER=capstone
POSTGRES_PASSWORD=changeme
POSTGRES_DB=capstone
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://capstone:changeme@db:5432/capstone

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-32-char-minimum-secret-in-production

# ── LLM Router ────────────────────────────────────────────────────────────────
# Priority order for LLM providers. Supported values: groq | claude | gemini
# The router attempts providers in this order, falling back automatically on failure.
PRIMARY_LLM=groq
SECONDARY_LLM=claude
TERTIARY_LLM=gemini

# Groq (primary) — get key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048

# Anthropic Claude direct API (secondary fallback)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (tertiary fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AWS (Serverless infra — S3, Secrets Manager, EventBridge; no Bedrock)
AWS_REGION=ap-southeast-1

# Internal automation shared secret (EventBridge Lambda-to-Lambda)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_AUTOMATION_TOKEN=change-me-in-production

# Embedding model (optional; all options output 384-dim vectors)
# EMBEDDING_MODEL=Xenova/bge-small-en-v1.5   # default — better retrieval quality
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2    # legacy option

# Cross-encoder re-ranker (optional, disabled by default)
# RERANKER_ENABLED=true
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANKER_TOP_N=20

# SSG/WSG API credentials (optional; falls back to seeded SCTP data if absent)
# SSG_CLIENT_ID=
# SSG_CLIENT_SECRET=
# SSG_API_BASE_URL=
# SSG_TOKEN_URL=
# SSG_CACHE_TTL_SECONDS=3600

# Live Matrix Dataset Source (optional; defaults to GitHub raw URL)
# Point to a CSV file with columns: year, sector, jobRole, skillCategory, demandIndex, supplyIndex, growthRate
# LIVE_MATRIX_SOURCE_URL=https://raw.githubusercontent.com/azniosman/dsai-capstone/main/data/seed/skills_intelligence.csv
