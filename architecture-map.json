    "schema_notes": [
      "All entities have tenant isolation via Tenant relation (nullable for global data)",
      "DocumentChunk uses pgvector for 384-dim embeddings with HNSW index",
      "DocumentChunk has generated tsvector column for full-text search with GIN index",
      "Hybrid search uses Reciprocal Rank Fusion (RRF k=60) to merge semantic + keyword results",
      "RagFeedback stores thumbs-up/down signals for re-ranking",
      "SsgCache implements TTL-based caching for SSG API responses",
      "UserProfile.careerIntelligence stores AI-extracted career profile as JSONB"
    ]
  },

  "ai_integrations": {
    "llm_providers": [
      {
        "name": "Groq",
        "file": "/nestjs-backend/src/intelligence/providers/groq.provider.ts",
        "model": "llama-3.3-70b-versatile (configurable)",
        "sdk": "groq-sdk",
        "priority": "Primary (configurable via PRIMARY_LLM)",
        "env_vars": ["GROQ_API_KEY", "GROQ_MODEL", "AI_TEMPERATURE", "AI_MAX_TOKENS"]
      },
      {
        "name": "Anthropic Claude",
        "file": "/nestjs-backend/src/intelligence/providers/claude.provider.ts",
        "model": "claude-3-5-sonnet-20241022 (configurable)",
        "sdk": "@anthropic-ai/sdk",
        "priority": "Secondary (configurable via SECONDARY_LLM)",
        "env_vars": ["ANTHROPIC_API_KEY", "CLAUDE_MODEL"]
      },
      {
        "name": "Google Gemini",
        "file": "/nestjs-backend/src/intelligence/providers/gemini.provider.ts",
        "model": "gemini-2.0-flash (configurable)",
        "sdk": "@google/generative-ai",
        "priority": "Tertiary (configurable via TERTIARY_LLM)",
        "env_vars": ["GEMINI_API_KEY", "GEMINI_MODEL"]
      }
    ],
    "embedding_models": [
      {
        "name": "BGE Small EN v1.5",
        "model_id": "Xenova/bge-small-en-v1.5",
        "dimensions": 384,
        "size": "~22 MB quantized",
        "default": true,
        "notes": "Better retrieval quality"
      },
      {
        "name": "MiniLM L6 v2",
        "model_id": "Xenova/all-MiniLM-L6-v2",
        "dimensions": 384,
        "size": "~23 MB quantized",
        "default": false,
        "notes": "Legacy option, fast"
      },
      {
        "name": "MiniLM L12 v2",
        "model_id": "Xenova/all-MiniLM-L12-v2",
        "dimensions": 384,
        "size": "~33 MB quantized",
        "default": false,
        "notes": "Higher MiniLM quality"
      }
    ],
    "reranker_models": [
      {
        "name": "MS MARCO MiniLM L6 v2",
        "model_id": "Xenova/ms-marco-MiniLM-L-6-v2",
        "enabled_by_default": false,
        "env_var": "RERANKER_ENABLED=true"
      }
    ],
    "rag_pipeline": {
      "file": "/nestjs-backend/src/rag/rag.service.ts",
      "stages": [
        "1. Embed query using ONNX sentence transformer",
        "2. Single SQL CTE: pgvector HNSW (semantic) + tsvector GIN (keyword) via FULL OUTER JOIN",
        "3. Reciprocal Rank Fusion (k=60) to merge branches",
        "4. Feedback boost: rrfScore += 0.01 * tanh(net_votes) for authenticated users",
        "5. Optional cross-encoder re-ranking (RERANKER_ENABLED=true)",
        "6. Slice to topK and return"
      ],
      "fallback": "CTE failure degrades to semantic-only automatically"
    },
    "ai_features": [
      {
        "feature": "Career Coach Chat",
        "endpoint": "POST /api/chat",
        "service": "IntelligenceService.chat()",
        "description": "Multi-turn chat with LLM provider chain"
      },
      {
        "feature": "Job Recommendations",
        "endpoint": "POST /api/recommend",
        "service": "IntelligenceService.getRecommendations()",
        "scoring": "0.55 content_similarity + 0.25 rule_match + 0.20 career_switcher_bonus"
      },
      {
        "feature": "Skill Gap Analysis",
        "endpoint": "GET /api/skill-gap/:profileId",
        "service": "IntelligenceService.getSkillGap()",
        "description": "Compare profile skills vs job role requirements"
      },
      {
        "feature": "Resume Parsing",
        "endpoint": "POST /api/upload-resume",
        "service": "IntelligenceService.parseResume()",
        "output": "name, email, phone, skills, experience_years"
      },
      {
        "feature": "Career Intelligence Extraction",
        "endpoint": "POST /api/copilot/extract",
        "service": "CopilotService.extractCareerProfile()",
        "output": "experience_level, top_skills, industries, strengths, improvement_areas, career_paths, professional_summary"
      },
      {
        "feature": "Career Analysis Report",
        "endpoint": "GET /api/copilot/analyze/:profileId",
        "service": "CopilotService.analyzeCareer()",
        "output": "Structured markdown report with 7 sections"
      },
      {
        "feature": "Career Plan Generation",
        "endpoint": "POST /api/copilot/career-plan",
        "service": "CopilotService.generateCareerPlan()",
        "output": "12-month plan with milestones, actions, Singapore programmes"
      },
      {
        "feature": "Resume Tips",
        "endpoint": "POST /api/copilot/resume-tips",
        "service": "CopilotService.getResumeTips()",
        "output": "6-8 actionable improvement tips"
      },
      {
        "feature": "Mock Interview",
        "endpoint": "POST /api/interview",
        "service": "IntelligenceService.interview()",
        "description": "AI interviewer for job title"
      },
      {
        "feature": "Resume Rewriter",
        "endpoint": "POST /api/resume-rewriter",
        "service": "IntelligenceService.rewriteResume()",
        "description": "Rewrite bullet point for target role"
      },
      {
        "feature": "JD Match",
        "endpoint": "POST /api/jd-match",
