      "script": "/scripts/deploy.sh",
      "services": ["db (:5432)", "backend (:8000)", "frontend (:3000)", "n8n (:5678)"]
    },
    "aws_serverless": {
      "workflow": "/.github/workflows/deploy-serverless.yml",
      "script": "/scripts/deploy-serverless.sh",
      "command": "gh workflow run deploy-serverless.yml -f environment=dev -f skip_terraform=true",
      "components": [
        "Lambda (backend API)",
        "API Gateway (HTTP)",
        "Aurora Serverless v2 (PostgreSQL + pgvector)",
        "S3 (frontend static)",
        "CloudFront (optional CDN)",
        "ECR (Docker images)",
        "EventBridge Scheduler (automation)",
        "SQS DLQ",
        "SNS alerts",
        "CloudWatch alarms"
      ],
      "notes": [
        "Full deploy (~35 min): deletes all non-ECR resources before terraform apply",
        "Quick deploy (~5 min): skip_terraform=true for code-only changes",
        "API Gateway URL and S3 bucket name change on every full deploy"
      ]
    },
    "lambda_considerations": [
      "update-function-code is not instant: warm containers may serve old code for 1-2 minutes",
      "Docker buildx must pass --provenance=false to avoid OCI manifest issues",
      "Embedding model is baked into Docker image at build time (no internet needed at runtime)",
      "OMP_NUM_THREADS=1 required to prevent FAISS/model loading memory issues",
      "Internal /internal/* endpoints invoked via Lambda Invoke API only (not API Gateway)"
    ]
  },

  "key_design_decisions": [
    {
      "decision": "Hybrid scoring formula",
      "formula": "0.55 * content_similarity + 0.25 * rule_match + 0.20 * career_switcher_bonus",
      "rationale": "Balances semantic matching with hard skill requirements and career-switcher inclusivity"
    },
    {
      "decision": "Skill levels",
      "values": "0 (missing), 0.5 (partial), 1.0 (strong)",
      "rationale": "Simple three-tier scale for gap severity calculation"
    },
    {
      "decision": "FAISS in-memory",
      "rationale": "Rebuilt on startup; no external vector store needed for capstone scale"
    },
    {
      "decision": "LLM provider chain",
      "order": "Groq -> Claude -> Gemini -> HTTP 503",
      "rationale": "Configurable fallback for reliability; all three providers optional"
    },
    {
      "decision": "Auth is optional",
      "rationale": "Core features work without login via OptionalJwtAuthGuard; unauthenticated requests default to Global tenant (ID 1)"
    },
    {
      "decision": "Multi-tenancy",
      "rationale": "All entities have tenant relation; Global tenant auto-created on startup"
    },
    {
      "decision": "Recommendation cache",
      "ttl": "300 seconds in-memory",
      "rationale": "Reduce LLM calls for repeated queries"
    },
    {
      "decision": "RAG retrieval pipeline",
      "stages": "embed(query) -> single SQL CTE (HNSW + GIN via FULL OUTER JOIN -> RRF k=60) -> feedback boost -> cross-encoder (opt-in) -> slice(0, topK)",
      "rationale": "Single DB round trip; CTE failure degrades to semantic-only automatically"
    },
    {
      "decision": "RAG feedback re-ranking",
      "formula": "rrfScore += 0.01 * tanh(net_feedback)",
      "rationale": "tanh normalises vote counts so even 10 votes saturates at +/-0.01, proportional to RRF score range (~0.016-0.033)"
    },
    {
      "decision": "Schema migrations",
      "approach": "updateSchema() runs on every cold start (additive-only - never drops)",
      "rationale": "Safe for Lambda cold starts; write migrations to src/migrations/ for destructive changes"
    },
    {
      "decision": "Internal automation endpoints",
      "security": "Lambda Invoke API only (no API Gateway route) + InternalTokenGuard",
      "rationale": "Defense in depth: primary guard is no public route; token validation is secondary"
    },
    {
      "decision": "Embedding model baked into Docker",
      "rationale": "No internet access needed at Lambda runtime; works without NAT Gateway (~$32/month savings)"
    }
  ]
}
