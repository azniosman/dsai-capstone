  "security_modules": {
    "guards": [
      {
        "name": "JwtAuthGuard",
        "file": "/nestjs-backend/src/auth/guards/jwt-auth.guard.ts",
        "strategy": "jwt",
        "description": "Requires valid JWT; throws 401 on failure"
      },
      {
        "name": "OptionalJwtAuthGuard",
        "file": "/nestjs-backend/src/auth/guards/optional-jwt-auth.guard.ts",
        "strategy": "jwt",
        "description": "Silently returns null user if JWT absent/invalid; used on public endpoints"
      },
      {
        "name": "LocalAuthGuard",
        "file": "/nestjs-backend/src/auth/guards/local-auth.guard.ts",
        "strategy": "local",
        "description": "Validates username/password for login"
      },
      {
        "name": "InternalTokenGuard",
        "file": "/nestjs-backend/src/common/guards/internal-token.guard.ts",
        "header": "X-Internal-Token",
        "description": "Validates shared secret for automation Lambda-to-Lambda calls; rejects without correct token"
      }
    ],
    "strategies": [
      {
        "name": "JwtStrategy",
        "file": "/nestjs-backend/src/auth/strategies/jwt.strategy.ts",
        "description": "Extracts user from JWT token"
      },
      {
        "name": "LocalStrategy",
        "file": "/nestjs-backend/src/auth/strategies/local.strategy.ts",
        "description": "Passport local strategy for username/password"
      }
    ],
    "middleware": [
      {
        "name": "Helmet",
        "file": "/nestjs-backend/src/main.ts",
        "description": "Security headers middleware"
      },
      {
        "name": "ThrottlerGuard",
        "file": "/nestjs-backend/src/main.ts",
        "config": "60 requests per 60 seconds (global)",
        "description": "Rate limiting"
      },
      {
        "name": "ValidationPipe",
        "file": "/nestjs-backend/src/main.ts",
        "options": "whitelist, transform, forbidNonWhitelisted",
        "description": "DTO validation and transformation"
      },
      {
        "name": "AllExceptionsFilter",
        "file": "/nestjs-backend/src/common/filters/all-exceptions.filter.ts",
        "description": "Global exception handling"
      },
      {
        "name": "TransformInterceptor",
        "file": "/nestjs-backend/src/common/interceptors/transform.interceptor.ts",
        "description": "Response transformation"
      },
      {
        "name": "CORS",
        "file": "/nestjs-backend/src/main.ts",
        "config": "Configurable via CORS_ALLOWED_ORIGINS env var",
        "description": "Cross-origin resource sharing"
      }
    ],
    "auth_flow": {
      "login": "POST /api/auth/login -> LocalAuthGuard -> AuthService.validateUser() -> JWT generation",
      "token_refresh": "POST /api/auth/refresh -> Verify refresh_token -> Generate new access_token",
      "logout": "Client-side token clearing (stateless JWT; no server-side invalidation)",
      "password_hashing": "bcrypt with saltRounds=10",
      "account_lockout": "5 failed attempts -> 15-minute lockout"
    }
  },

