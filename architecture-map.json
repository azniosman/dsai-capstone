  "background_jobs": {
    "automation_lambdas": [
      {
        "name": "ssg-sync",
        "file": "/lambdas/automation/ssg_sync.py",
        "handler": "lambdas.automation.ssg_sync.handler",
        "schedule": "Daily 01:00 UTC (courses), 01:30 UTC (job roles)",
        "memory": 256,
        "timeout": 300,
        "description": "Sync SSG course and job role cache",
        "endpoints_called": ["/internal/sync/ssg/courses", "/internal/sync/ssg/jobroles"]
      },
      {
        "name": "cache-cleanup",
        "file": "/lambdas/automation/cache_cleanup.py",
        "handler": "lambdas.automation.cache_cleanup.handler",
        "schedule": "Daily 03:00 UTC",
        "memory": 128,
        "timeout": 60,
        "description": "Bulk-delete expired ssg_cache rows",
        "endpoints_called": ["/internal/cache/cleanup"]
      },
      {
        "name": "recommendation-refresh",
        "file": "/lambdas/automation/recommendation_refresh.py",
        "handler": "lambdas.automation.recommendation_refresh.handler",
        "schedule": "Daily 02:00 UTC",
        "memory": 512,
        "timeout": 600,
        "description": "Pre-compute recommendation scores (Phase 2 stub)",
        "endpoints_called": ["/internal/recommendations/precompute"]
      },
      {
        "name": "embedding-backfill",
        "file": "/lambdas/automation/embedding_backfill.py",
        "handler": "lambdas.automation.embedding_backfill.handler",
        "schedule": "Every 6 hours",
        "memory": 512,
        "timeout": 600,
        "description": "Re-embed document_chunk rows with NULL embedding",
        "endpoints_called": ["/internal/embeddings/backfill"]
      },
      {
        "name": "market-insights",
        "file": "/lambdas/automation/market_insights.py",
        "handler": "lambdas.automation.market_insights.handler",
        "schedule": "Daily 04:00 UTC",
        "memory": 256,
        "timeout": 120,
        "description": "Aggregate market insight metrics",
        "endpoints_called": ["/internal/analytics/aggregate"]
      },
      {
        "name": "lambda-warmup",
        "file": "/lambdas/automation/lambda_warmup.py",
        "handler": "lambdas.automation.lambda_warmup.handler",
        "schedule": "Every 5 minutes (optional)",
        "memory": 128,
        "timeout": 30,
        "description": "Warm-up ping to keep Lambda containers warm",
        "endpoints_called": ["/internal/health"]
      }
    ],
    "eventbridge_rules": [
      {"name": "ssg-courses-sync", "schedule": "cron(0 1 * * ? *)", "target": "ssg-sync", "task": "sync_courses"},
      {"name": "ssg-jobroles-sync", "schedule": "cron(30 1 * * ? *)", "target": "ssg-sync", "task": "sync_jobroles"},
      {"name": "recommendation-refresh", "schedule": "cron(0 2 * * ? *)", "target": "recommendation-refresh"},
      {"name": "cache-cleanup", "schedule": "cron(0 3 * * ? *)", "target": "cache-cleanup"},
      {"name": "embedding-backfill", "schedule": "rate(6 hours)", "target": "embedding-backfill"},
      {"name": "market-insights", "schedule": "cron(0 4 * * ? *)", "target": "market-insights"},
      {"name": "lambda-warmup", "schedule": "rate(5 minutes)", "target": "lambda-warmup"}
    ],
    "n8n_workflows": [
      {
        "name": "resume_ingestion",
        "file": "/n8n/workflows/resume_ingestion.json",
